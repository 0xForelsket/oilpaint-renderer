{
  "name": "oilpaint-monorepo",
  "private": true,
  "description": "oilpaint: Rust/WASM oil-painting engine and TypeScript library (packages/ from L2)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "xhost": "node ci/xhost/xhost.mjs",
    "xhost:node": "node ci/xhost/run-node.mjs",
    "xhost:browsers": "node ci/xhost/run-browsers.mjs",
    "xhost:compare": "node ci/xhost/compare.mjs",
    "build:wasm": "node packages/oilpaint/scripts/build-wasm.mjs",
    "gen:types": "node packages/oilpaint/scripts/gen-types.mjs",
    "typecheck": "tsc -p packages/oilpaint --noEmit",
    "test:ts": "node --test \"packages/oilpaint/test/*.test.ts\"",
    "preview": "node packages/oilpaint/preview/serve.mjs",
    "gen:author": "node packages/oilpaint/scripts/gen-author.mjs",
    "test:preview": "node packages/oilpaint/preview/verify.mjs",
    "review:brushes": "node packages/oilpaint/preview/gallery.mjs",
    "review:iteration2": "node packages/oilpaint/preview/review-iteration-2.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.58.2",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
